{
    "name": "code-quality-tools",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev --no-cache --continue",
        "lint": "oxlint && turbo lint",
        "test": "turbo test",
        "clean": "turbo clean && rm -rf node_modules",
        "format": "oxfmt",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "turbo build && turbo test && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@jarsec/oxlint-config": "workspace:*",
        "@jarsec/tsconfig": "workspace:*",
        "commitizen": "4.3.2",
        "cz-conventional-changelog": "3.3.0",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "oxlint-tsgolint": "7.0.2007",
        "turbo": "latest"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "packageManager": "pnpm@12.17.0"
}
